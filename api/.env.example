# ============================================================================
# Variáveis de Ambiente para Produção (PostgreSQL em Nuvem)
# ============================================================================

# URL de Conexão JDBC do PostgreSQL (Exemplo com SSL ativado)
SPRING_DATASOURCE_URL=jdbc:postgresql://seu-host-postgres:5432/taskdb?sslmode=require

# Usuário do Banco de Dados PostgreSQL
SPRING_DATASOURCE_USERNAME=seu_usuario_postgres

# Senha do Banco de Dados PostgreSQL
SPRING_DATASOURCE_PASSWORD=sua_senha_postgres

# Porta em que a API Spring Boot irá executar
PORT=8080
