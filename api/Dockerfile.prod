# Dockerfile.prod - Produção com PostgreSQL (Neon) e Imagem Otimizada JRE
# Stage 1: Build da aplicação
FROM eclipse-temurin:21-jdk AS builder

WORKDIR /app

COPY gradlew gradlew.bat build.gradle settings.gradle gradle.properties ./
COPY gradle gradle
RUN chmod +x gradlew

COPY src src

RUN ./gradlew bootJar -x test -q

# Stage 2: Imagem final leve e segura (JRE)
FROM eclipse-temurin:21-jre

WORKDIR /opt/app

RUN groupadd -r appuser && useradd -r -g appuser appuser

COPY --from=builder /app/build/libs/*.jar app.jar

RUN chown appuser:appuser app.jar

USER appuser

EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=prod
ENV PORT=8080

ENTRYPOINT ["sh", "-c", "java -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod} -Dserver.port=${PORT:-8080} -jar /opt/app/app.jar"]
